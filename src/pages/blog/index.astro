---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featuredPosts = posts.filter((post) => post.data.featured);
const remainingPosts = posts.filter((post) => !post.data.featured);
---

<Layout title="Blog" description="Thoughts on AI, research, and building intelligent agents">
  <section class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-16 reveal">
        <h1 class="heading-1 text-stone-900 dark:text-stone-50 mb-4">Blog</h1>
        <p class="text-stone-500 dark:text-stone-400 max-w-xl leading-relaxed">
          Thoughts on AI agents, reinforcement learning, and the journey of building intelligent systems.
        </p>
      </header>

      <!-- Featured launch -->
      {posts.length > 0 ? (
        <>
          {featuredPosts.map((post) => (
            <article class="mb-16 group reveal">
              <a
                href={post.data.externalUrl || `/blog/${post.slug}/`}
                target={post.data.externalUrl ? "_blank" : undefined}
                rel={post.data.externalUrl ? "noopener noreferrer" : undefined}
                class="block overflow-hidden rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/50 transition-all duration-500 hover:-translate-y-1 hover:border-stone-300 dark:hover:border-stone-700 hover:shadow-xl hover:shadow-stone-900/5 dark:hover:shadow-black/20"
              >
                {post.data.heroImage && (
                  <div class="relative overflow-hidden border-b border-stone-200/80 dark:border-stone-800 bg-[#f3eee8] dark:bg-stone-950 p-3 sm:p-5">
                    <img
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt || post.data.title}
                      class="w-full h-auto transition-transform duration-700 group-hover:scale-[1.015]"
                      loading="eager"
                    />
                    <span class="absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full border border-white/70 bg-white/90 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.14em] text-stone-700 shadow-sm backdrop-blur dark:border-stone-700 dark:bg-stone-900/90 dark:text-stone-200">
                      Featured launch
                    </span>
                  </div>
                )}

                <div class="p-6 md:p-8">
                  <div class="mb-3 flex flex-wrap items-center gap-2">
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="text-xs text-stone-400 dark:text-stone-500"
                    >
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })}
                    </time>
                    {post.data.externalUrl && (
                      <span class="inline-flex items-center gap-1 rounded-full border border-accent-200 bg-accent-50 px-2 py-0.5 text-xs text-accent-600 dark:border-accent-500/20 dark:bg-accent-950/50 dark:text-accent-400">
                        {post.data.sourceLabel || 'External'}
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                      </span>
                    )}
                  </div>

                  <h2 class="font-serif text-2xl leading-tight text-stone-900 transition-colors duration-300 group-hover:text-accent-700 dark:text-stone-100 dark:group-hover:text-accent-400 md:text-3xl">
                    {post.data.title}
                  </h2>
                  <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone-500 dark:text-stone-400 md:text-base">
                    {post.data.description}
                  </p>

                  <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs text-stone-500 dark:bg-stone-800/50 dark:text-stone-400">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                    <span class="inline-flex items-center gap-1.5 text-sm text-accent-600 transition-colors duration-300 group-hover:text-accent-700 dark:text-accent-400 dark:group-hover:text-accent-300">
                      Read the launch story
                      <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}

          {remainingPosts.length > 0 && (
            <div>
              {featuredPosts.length > 0 && (
                <h2 class="section-label mb-6 reveal">More writing</h2>
              )}
              <div class="space-y-6">
                {remainingPosts.map((post) => (
            <article class="card card-hover p-6 md:p-8 group reveal">
              <a href={post.data.externalUrl || `/blog/${post.slug}/`} target={post.data.externalUrl ? "_blank" : undefined} rel={post.data.externalUrl ? "noopener noreferrer" : undefined} class="block">
                <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
                  {post.data.heroImage && (
                    <div class="flex-shrink-0 w-full md:w-48 h-32 rounded-lg overflow-hidden">
                      <img
                        src={post.data.heroImage}
                        alt={post.data.heroImageAlt || post.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="text-xs text-stone-400 dark:text-stone-500"
                      >
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })}
                      </time>
                      {post.data.externalUrl && (
                        <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 bg-accent-50 dark:bg-accent-950/50 text-accent-600 dark:text-accent-400 rounded-full border border-accent-200 dark:border-accent-500/20">
                          {post.data.sourceLabel || 'Amazon Science'}
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                        </span>
                      )}
                    </div>
                    <h2 class="heading-3 text-stone-900 dark:text-stone-100 mt-2 mb-3 group-hover:text-accent-700 dark:group-hover:text-accent-400 transition-colors duration-300">
                      {post.data.title}
                    </h2>
                    <p class="text-stone-500 dark:text-stone-400 line-clamp-2 text-sm leading-relaxed">
                      {post.data.description}
                    </p>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-4">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="px-2.5 py-0.5 bg-stone-100 dark:bg-stone-800/50 text-stone-500 dark:text-stone-400 text-xs rounded-full">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </a>
            </article>
                ))}
              </div>
            </div>
          )}
        </>
      ) : (
        <div class="text-center py-20 reveal">
          <div class="w-14 h-14 mx-auto mb-6 rounded-xl bg-stone-100 dark:bg-stone-800/50 flex items-center justify-center">
            <svg class="w-7 h-7 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
            </svg>
          </div>
          <h2 class="font-serif text-xl text-stone-900 dark:text-stone-100 mb-2">No posts yet</h2>
          <p class="text-stone-500 dark:text-stone-400 text-sm">
            Check back soon for new articles.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>
